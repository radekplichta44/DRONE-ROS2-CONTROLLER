<?xml version="1.0"?>
<robot name="mc900_robot">

  <material name="white"><color rgba="1 1 1 1" /></material>
  <material name="blue"><color rgba="0.2 0.2 1 1" /></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>

  <link name="base_link"></link>

  <link name="chassis">
    <visual>
      <geometry><box size="0.5 0.08 0.05"/></geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.1"/> 
  </joint>

  <link name="front_rail">
    <visual>
      <geometry><box size="0.05 0.3 0.05"/></geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="front_rail_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_rail"/>
    <origin xyz="0.225 0 0"/> 
  </joint>

  <link name="back_rail">
    <visual>
      <geometry><box size="0.05 0.3 0.05"/></geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="back_rail_joint" type="fixed">
    <parent link="chassis"/>
    <child link="back_rail"/>
    <origin xyz="-0.225 0 0"/> 
  </joint>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser"/>
    <origin xyz="0 0 0.100" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.08" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.225 0.15 0.08" rpy="0 0 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.08" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.225 -0.15 0.08" rpy="0 0 0"/>
  </joint>

  <link name="back_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.08" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="back_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_left_wheel"/>
    <origin xyz="-0.225 0.15 0.08" rpy="0 0 0"/>
  </joint>

  <link name="back_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.08" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="back_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_right_wheel"/>
    <origin xyz="-0.225 -0.15 0.08" rpy="0 0 0"/>
  </joint>

</robot>